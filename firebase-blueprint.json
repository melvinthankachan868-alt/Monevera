        "type": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 32 },
        "source": { "type": "string", "maxLength": 128 },
        "note": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
