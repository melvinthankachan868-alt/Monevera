        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "source": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 32 },
        "note": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "ownerId", "amount", "source", "type", "date"]
    },
    "Allowance": {
      "title": "Allowance",
      "description": "Separate allowance benefits (Travel, Food, Housing, etc.)",
