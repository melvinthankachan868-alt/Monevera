  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account root document"
    },
    "/users/{userId}/income/{incomeId}": {
      "schema": "Income",
      "description": "User income records"
    },
    "/users/{userId}/allowances/{allowanceId}": {
      "schema": "Allowance",
      "description": "Separate allowance benefits"
    },
    "/users/{userId}/bonuses/{bonusId}": {
      "schema": "Bonus",
      "description": "Variable bonuses and extra non-salary income"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "User expense records"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "User monthly budget limits"
    },
    "/users/{userId}/moneyOwed/{recordId}": {
      "schema": "MoneyOwed",
      "description": "User money lent or borrowed records"
    },
    "/users/{userId}/moneyOwed/{recordId}/payments/{paymentId}": {
      "schema": "MoneyOwedPayment",
      "description": "Installment payments on money owed"
    },
    "/users/{userId}/loans/{loanId}": {
      "schema": "Loan",
      "description": "User debts and loans"
    },
    "/users/{userId}/loanPayments/{paymentId}": {
      "schema": "LoanPayment",
      "description": "User loan repayment records"
    },
    "/users/{userId}/bills/{billId}": {
      "schema": "Bill",
      "description": "User bills and utility payments"
    },
    "/users/{userId}/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "User recurring subscriptions"
    },
    "/users/{userId}/emergencyFund/{recordId}": {
      "schema": "EmergencyFund",
      "description": "User emergency fund parameters"
    },
    "/users/{userId}/emergencyFund/contributions/{contributionId}": {
      "schema": "EmergencyFundContribution",
      "description": "Emergency fund deposits and withdrawals"
    },
    "/users/{userId}/financialReminders/{reminderId}": {
      "schema": "FinancialReminder",
      "description": "General financial obligation reminders"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "Logged alert notifications"
    },
    "/users/{userId}/transfers/{transferId}": {
      "schema": "Transfer",
      "description": "Internal fund transfers"
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": "FinancialAccount",
      "description": "User manual account balances"
    },
    "/users/{userId}/savings/{savingId}": {
      "schema": "Savings",
      "description": "User savings allocations"
    },
    "/users/{userId}/investments/{investmentId}": {
      "schema": "Investment",
      "description": "User investment holdings"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "User financial goals"
    },
    "/users/{userId}/subcategories/{subcategoryId}": {
      "schema": "Subcategory",
