        "originalAmount": { "type": "number" },
        "amountSettled": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "dateGivenOrBorrowed": { "type": "string", "maxLength": 32 },
        "dueDate": { "type": "string", "maxLength": 32 },
        "description": { "type": "string", "maxLength": 512 },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "note": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "maxLength": 32 },
        "reminderEnabled": { "type": "boolean" },
        "reminderDaysBefore": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "ownerId", "type", "personName", "originalAmount", "remainingAmount", "dueDate", "status"]
    },
    "MoneyOwedPayment": {
      "title": "MoneyOwedPayment",
